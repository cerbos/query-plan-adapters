{
  "name": "@cerbos/orm-prisma",
  "version": "5.2.0",
  "homepage": "https://cerbos.dev",
  "description": "Prisma adapter for Cerbos query plans",
  "repository": {
    "type": "git",
    "url": "https://github.com/cerbos/query-plan-adapters",
    "directory": "prisma"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "generator/index.cjs",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/generated/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the translator unit test: offline, so no Cerbos sidecar, no `db push`, and no generated client. It is also engine-agnostic — it produces where-inputs and never hands one to a Prisma client — which is why it has no v6/v7 split. The conformance harness lives in ../conformance/harnesses/prisma/.",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "test": "jest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "//devDependencies": "Also the install ../conformance/harnesses/prisma/ runs on (its node_modules links here): the store drivers and testcontainers are its, not the unit suite's.",
  "devDependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@cerbos/api": "^0.11.2",
    "@cerbos/core": "^0.33.2",
    "@cerbos/grpc": "^0.29.3",
    "@cerbos/http": "^0.30.2",
    "@grpc/grpc-js": "^1.14.5",
    "@jest/globals": "^30.2.0",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@prisma/client-v6": "npm:@prisma/client@^6.0.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@tsconfig/node24": "^24.0.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "expect-type": "^1.1.0",
    "mariadb": "^3.5.3",
    "prisma": "^7.5.0",
    "prisma-v6": "npm:prisma@^6.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "^2.0.0"
    },
    "mysql2": "^3.22.0",
    "mariadb": "$mariadb"
  },
  "keywords": [
    "cerbos",
    "prisma",
    "orm",
    "authorization",
    "permissions"
  ],
  "dependencies": {
    "@prisma/generator-helper": "^7.10.1",
    "re2js": "^2.9.1"
  },
  "bin": {
    "cerbos-prisma-datamodel": "generator/index.cjs"
  }
}
