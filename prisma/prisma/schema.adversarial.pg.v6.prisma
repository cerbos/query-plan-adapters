// Prisma 6 + PostgreSQL client for the shared adversarial differential harness
// (cerbos/query-plan-adapters#320). Keep the data model in lockstep with
// schema.adversarial.prisma; only the generator and datasource configuration differ, so each
// (Prisma major x store) leg executes through a genuinely matched client.
//
// The URL comes from the environment because Prisma 6's `db push` has no `--url` flag: the
// adversarial jest globalSetup starts the container and exports DATABASE_URL before invoking it.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-adversarial-pg-v6"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdversarialResource {
  id              String                @id
  aBool           Boolean
  aString         String
  aNumber         Int
  aDouble         Float?
  aOptionalString String?
  createdBy       String
  scope           String?
  createdAt       DateTime?
  tags            AdversarialTag[]
  categories      AdversarialCategory[]
}

model AdversarialTag {
  id         String              @id @default(cuid())
  tagId      String
  name       String?
  resource   AdversarialResource @relation(fields: [resourceId], references: [id])
  resourceId String
}

model AdversarialCategory {
  id            String                   @id @default(cuid())
  name          String
  resource      AdversarialResource      @relation(fields: [resourceId], references: [id])
  resourceId    String
  subCategories AdversarialSubCategory[]
}

model AdversarialSubCategory {
  id         String              @id @default(cuid())
  name       String
  category   AdversarialCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  labels     AdversarialLabel[]
}

model AdversarialLabel {
  id            String                 @id @default(cuid())
  name          String?
  subCategory   AdversarialSubCategory @relation(fields: [subCategoryId], references: [id])
  subCategoryId String
}
