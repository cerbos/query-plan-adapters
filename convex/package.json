{
  "name": "@cerbos/orm-convex",
  "version": "0.2.0",
  "homepage": "https://cerbos.dev",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/cerbos/query-plan-adapters",
    "directory": "packages/convex"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the translator unit test: it reads its plans from conformance/wire-fixtures/ and its expected filters from golden/expectations.json, so it needs no Cerbos sidecar, no Convex backend and no Docker. `test:adversarial` needs both. `golden:update` rewrites the golden expectations from what the translator emits today — a deliberate act whose safety is the diff a reviewer reads, exactly like conformance/scripts/regenerate-wire-fixtures.sh.",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "test": "jest",
    "golden:update": "GOLDEN_UPDATE=1 jest src/translator.test.ts",
    "test:adversarial": "cerbos run --log-level=error --set=storage.disk.directory=../conformance/policies --set=telemetry.disabled=true -- jest --config jest.adversarial.config.js --runInBand",
    "test:integration": "npm run typecheck && npm run test:adversarial",
    "convex:deploy": "npx convex deploy --url ${CONVEX_URL:-http://127.0.0.1:3210} --admin-key ${CONVEX_ADMIN_KEY}",
    "convex:up": "docker compose up -d && echo 'Waiting for Convex backend...' && sleep 5",
    "convex:down": "docker compose down -v"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cerbos/core": "^0.33.0",
    "@cerbos/grpc": "^0.29.0",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "convex": "^1.21.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.4.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0"
  }
}
