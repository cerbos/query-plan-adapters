<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="test-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>dev.cerbos.queryplan.springdata.testmodel.ResourceEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.TagEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.CategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.SubCategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.LabelEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.OwnerEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NestedEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NextLevelEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialParentEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialInnerEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:cerbostest;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

    <!-- Isolated database for RepositorySurfaceTest, which seeds rows of its own and reads them
         back through a real repository. Sharing test-pu would let create-drop wipe them out from
         under whichever class ran second. -->
    <persistence-unit name="repository-surface-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>dev.cerbos.queryplan.springdata.testmodel.ResourceEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.TagEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.CategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.SubCategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.LabelEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.OwnerEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NestedEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NextLevelEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialParentEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialInnerEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:cerbosrepo;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

    <!-- The offline translator unit test (SpringDataTranslatorTest): no JDBC connection at all.
         Hibernate is told the dialect rather than discovering it, and criteria literals are
         INLINED so the SQL the suite records carries the operands rather than placeholders. The
         dialect below is only the default; the suite overrides it per rendered dialect. -->
    <persistence-unit name="translator-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>dev.cerbos.queryplan.springdata.testmodel.ResourceEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.TagEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.CategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.SubCategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.LabelEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.OwnerEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NestedEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NextLevelEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialParentEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialInnerEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.boot.allow_jdbc_metadata_access" value="false"/>
            <property name="hibernate.criteria.value_handling_mode" value="INLINE"/>
        </properties>
    </persistence-unit>

    <!-- Isolated database for the adversarial differential suite so its seed data never
         interferes with the other test classes sharing the default in-memory DB. -->
    <persistence-unit name="adversarial-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>dev.cerbos.queryplan.springdata.testmodel.ResourceEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.TagEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.CategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.SubCategoryEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.LabelEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.OwnerEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NestedEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.NextLevelEmbeddable</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialParentEntity</class>
        <class>dev.cerbos.queryplan.springdata.testmodel.AdversarialInnerEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:cerbosadv;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
