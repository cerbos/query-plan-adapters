# frozen_string_literal: true

source "https://rubygems.org"

gemspec

group :development, :test do
  # The official Cerbos Ruby SDK (https://github.com/cerbos/cerbos-sdk-ruby). The adversarial
  # harness plans and checks against a real PDP through it, so its output types are what the
  # adapter is proved against.
  gem "cerbos", "~> 0.14"
  # The official MongoDB Ruby driver, which executes every emitted filter in the adversarial
  # harness and serialises it in the translator unit test. The adapter itself does not depend on
  # it: it returns plain Hashes.
  gem "mongo", "~> 2.21"
  gem "rake", "~> 13.2"
  gem "rspec", "~> 3.13"
  gem "standard", "~> 1.50"
end
