# frozen_string_literal: true

source "https://rubygems.org"

gemspec

group :development, :test do
  # The official Cerbos Ruby SDK (https://github.com/cerbos/cerbos-sdk-ruby). The adversarial
  # harness plans and checks against a real PDP through it, so its output types are what the
  # adapter is proved against. `~> 0.13`, not 0.14: cerbos 0.14 requires Ruby 3.3, and the CI
  # matrix still runs the offline suites on Ruby 3.2, which resolves 0.13 instead.
  gem "cerbos", "~> 0.13"
  # The official MongoDB Ruby driver, which executes every emitted filter in the adversarial
  # harness and serialises it in the translator unit test. The adapter itself does not depend on
  # it: it returns plain Hashes.
  gem "mongo", "~> 2.21"
  # Optional for consumers — `require "cerbos/mongodb/mongoid"` is the only file that loads
  # it — and exercised here by spec/mongoid_spec.rb and the "through Mongoid" corpus leg.
  gem "mongoid", "~> 9.0"
  gem "rake", "~> 13.2"
  gem "rspec", "~> 3.13"
  gem "standard", "~> 1.50"
end
