# frozen_string_literal: true

# Use the packed gem, never ../ (ADR 0002). run.sh unpacks it into vendor/, so a lib/ file
# missing from the gemspec's `files` list fails here instead of for a consumer.
source "https://rubygems.org"

gem "cerbos-activerecord", path: "vendor/cerbos-activerecord"

# The gemspec's full range. No lockfile is committed, so each run gets the newest ActiveRecord
# in range. (The TypeScript examples get this from a lockfile plus Renovate bumps.)
gem "activerecord", ">= 7.1", "< 9.0"
gem "cerbos", "~> 0.13"
gem "sqlite3", "~> 2.6"
