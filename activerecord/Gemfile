# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "rake", "~> 13.2"

group :development do
  gem "irb"
end

group :docs do
  gem "commonmarker", "~> 2.10"
  gem "webrick", "~> 1.9"
  gem "yard", "~> 0.9"
end

group :lint do
  gem "rubocop-rake", "~> 0.7"
  gem "rubocop-rspec", "~> 3.6"
  gem "standard", "~> 1.50"
end

group :test do
  # The trailing `.0` pins each CI leg to one minor series. `~> 7.1` would resolve to 7.2.
  gem "activerecord", "~> #{ENV.fetch("ACTIVERECORD_VERSION", "8.0")}.0"
  # The official Cerbos Ruby SDK. The adapter is tested against its output types.
  gem "cerbos", "~> 0.13"
  # The conformance suite's stores (ADAPTER_TEST_DB): mysql2 and pg are ActiveRecord's own
  # MySQL and PostgreSQL adapters. SQLite is the default.
  gem "mysql2", "~> 0.5"
  gem "pg", "~> 1.5"
  gem "rspec", "~> 3.13"
  gem "sqlite3", "~> 2.6"
end
