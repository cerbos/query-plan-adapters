{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/consumer-cases-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "principal", "action", "pagination", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["filtered", "alwaysAllowed", "alwaysDenied", "paginated", "composed"] },
          "principal": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "pagination": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["pageSize", "pageSizes"],
                "properties": {
                  "pageSize": { "type": "integer", "minimum": 1 },
                  "pageSizes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ids"],
            "properties": {
              "kind": { "enum": ["KIND_CONDITIONAL", "KIND_ALWAYS_ALLOWED", "KIND_ALWAYS_DENIED"] },
              "ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
