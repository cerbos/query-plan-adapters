{
  "type": "object",
  "required": [
    "schemaVersion",
    "adapter",
    "package",
    "workflow",
    "commands",
    "semanticEnvironments",
    "consumer",
    "outcomes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "adapter": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "package": {
      "type": "object",
      "required": [
        "ecosystem",
        "name"
      ],
      "properties": {
        "ecosystem": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "object",
      "required": [
        "test",
        "typecheck",
        "golden",
        "consumer"
      ],
      "properties": {
        "test": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "typecheck": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "golden": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "consumer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "semanticEnvironments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "env"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "env": {
            "type": "object",
            "patternProperties": {
              "^[\\s\\S]*$": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "consumer": {
      "type": "object",
      "required": [
        "coverage"
      ],
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "type": "string",
              "const": "artifact-install"
            },
            {
              "type": "string",
              "const": "usage-only"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "patternProperties": {
        "^[\\s\\S]*$": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "matched"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "status",
                "reason",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "rejected"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "upstream-blocked"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unassessed"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/manifest-v1.schema.json",
  "additionalProperties": false
}
