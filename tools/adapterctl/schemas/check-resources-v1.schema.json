{
  "type": "object",
  "required": [
    "schemaVersion",
    "principal",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "principal": {
      "type": "object",
      "patternProperties": {
        "^[\\s\\S]*$": {}
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "attr"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "attr": {
            "type": "object",
            "patternProperties": {
              "^[\\s\\S]*$": {}
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/check-resources-v1.schema.json",
  "additionalProperties": false
}
