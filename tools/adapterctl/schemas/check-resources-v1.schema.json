{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/check-resources-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "principal", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "principal": { "type": "object" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "attr"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "attr": { "type": "object" }
        }
      }
    }
  }
}
