{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "oracleExpectation"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "oracleExpectation": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "proper-subset" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": {
                  "kind": { "enum": ["empty", "total"] },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
