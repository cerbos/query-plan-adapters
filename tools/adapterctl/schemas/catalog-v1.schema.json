{
  "type": "object",
  "required": [
    "schemaVersion",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "oracleExpectation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "oracleExpectation": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "proper-subset"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "empty"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "total"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerbos.dev/query-plan-adapters/adapterctl/catalog-v1.schema.json",
  "additionalProperties": false
}
