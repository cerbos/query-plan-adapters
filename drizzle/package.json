{
  "name": "@cerbos/orm-drizzle",
  "version": "0.4.1",
  "homepage": "https://cerbos.dev",
  "description": "Drizzle ORM adapter for Cerbos query plans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerbos/query-plan-adapters.git",
    "directory": "drizzle"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the offline unit suite: caller-supplied options, the refusal type and malformed plans. It needs no Cerbos, no database and no Docker. The conformance harness lives in ../conformance/harnesses/drizzle/.",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "jest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "//devDependencies": "Also the install ../conformance/harnesses/drizzle/ runs on (its node_modules links here): the store drivers and testcontainers are its, not the unit suite's.",
  "devDependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@cerbos/api": "^0.11.2",
    "@cerbos/core": "^0.33.2",
    "@cerbos/grpc": "^0.29.3",
    "@cerbos/http": "^0.30.2",
    "@grpc/grpc-js": "^1.14.5",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/better-sqlite3": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.4",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "jest": "^30.0.0",
    "mysql2": "^3.23.3",
    "pg": "^8.22.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0",
    "drizzle-orm": "^0.44.0 || ^0.45.0 || ^1.0.0-rc.5"
  },
  "keywords": [
    "cerbos",
    "drizzle",
    "orm",
    "authorization",
    "permissions"
  ]
}
