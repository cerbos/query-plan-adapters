{
  "name": "@cerbos/orm-drizzle",
  "version": "0.2.0",
  "homepage": "https://cerbos.dev",
  "description": "Drizzle ORM adapter for Cerbos query plans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerbos/query-plan-adapters.git",
    "directory": "packages/drizzle"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the offline unit suite: caller-supplied options, the refusal type and malformed plans. It needs no Cerbos, no database and no Docker. `test:adversarial*` replays the recorded conformance goldens (../conformance/golden/) against a real store and needs no PDP; the PostgreSQL and MySQL legs need Docker.",
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "version": "git add -A src",
    "test": "jest",
    "test:adversarial": "jest --config jest.adversarial.config.js",
    "test:adversarial:postgres": "ADAPTER_TEST_DB=postgres npm run test:adversarial",
    "test:adversarial:mysql": "ADAPTER_TEST_DB=mysql npm run test:adversarial"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cerbos/core": "^0.33.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.4",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "jest": "^30.0.0",
    "mysql2": "^3.23.3",
    "pg": "^8.22.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0",
    "drizzle-orm": "^0.44.0 || ^0.45.0"
  },
  "dependencies": {
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "tslib": "^2.8.1"
  },
  "keywords": [
    "cerbos",
    "drizzle",
    "orm",
    "authorization",
    "permissions"
  ]
}
