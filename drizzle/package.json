{
  "name": "@cerbos/orm-drizzle",
  "version": "0.2.0",
  "homepage": "https://cerbos.dev",
  "description": "Drizzle ORM adapter for Cerbos query plans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerbos/query-plan-adapters.git",
    "directory": "packages/drizzle"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the translator unit test: it reads its plans from conformance/wire-fixtures/ and its expected SQL from golden/expectations.json, so it needs no Cerbos sidecar, no database and no Docker. Only `test:adversarial*` needs a PDP and a store. `golden:update` rewrites the golden expectations from what the translator emits today — a deliberate act whose safety is the diff a reviewer reads, exactly like conformance/scripts/regenerate-wire-fixtures.sh.",
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "version": "git add -A src",
    "test": "jest",
    "golden:update": "GOLDEN_UPDATE=1 jest src/translator.test.ts",
    "test:adversarial": "cerbos run --log-level=error --set=server.grpcListenAddr=:3621 --set=server.httpListenAddr=:3620 --set=storage.disk.directory=../conformance/policies --set=telemetry.disabled=true -- jest --config jest.adversarial.config.js",
    "test:adversarial:postgres": "ADAPTER_TEST_DB=postgres npm run test:adversarial"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cerbos/core": "^0.33.0",
    "@cerbos/grpc": "^0.29.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.4",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "jest": "^30.0.0",
    "pg": "^8.22.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0",
    "drizzle-orm": "^0.44.0 || ^0.45.0"
  },
  "dependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "tslib": "^2.8.1"
  },
  "keywords": [
    "cerbos",
    "drizzle",
    "orm",
    "authorization",
    "permissions"
  ]
}
