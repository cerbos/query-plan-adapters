{
  "//": "Type-checks the sources and the unit suite in test/. Never emits, so nothing here can reach lib/.",
  "extends": "./tsconfig.json",
  "include": [
    "src",
    "test"
  ],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
