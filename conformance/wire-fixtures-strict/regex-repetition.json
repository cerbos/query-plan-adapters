{
  "action": "regex-repetition",
  "resourceKind": "adversarial",
  "filter": {
    "kind": "KIND_CONDITIONAL",
    "condition": {
      "expression": {
        "operator": "matches",
        "operands": [
          {
            "variable": "request.resource.attr.aString"
          },
          {
            "value": "^(ab){1,2}$"
          }
        ]
      }
    }
  }
}
