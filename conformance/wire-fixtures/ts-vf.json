{
  "action": "ts-vf",
  "resourceKind": "adversarial",
  "filter": {
    "kind": "KIND_CONDITIONAL",
    "condition": {
      "expression": {
        "operator": "gt",
        "operands": [
          {
            "expression": {
              "operator": "timestamp",
              "operands": [
                {
                  "value": "__NOW_MINUS_24H__"
                }
              ]
            }
          },
          {
            "expression": {
              "operator": "timestamp",
              "operands": [
                {
                  "variable": "request.resource.attr.createdAt"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
