{
  "name": "@cerbos/orm-mongoose",
  "version": "3.0.0",
  "homepage": "https://cerbos.dev",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/cerbos/query-plan-adapters",
    "directory": "packages/mongoose"
  },
  "bugs": {
    "url": "https://github.com/cerbos/query-plan-adapters/issues"
  },
  "author": "Cerbos <help@cerbos.dev> (https://cerbos.dev)",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//test": "`test` is the translator unit test: it reads its plans from conformance/wire-fixtures/, so it needs no Cerbos sidecar and no MongoDB. Only `test:adversarial` needs a PDP and a server.",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepare": "npm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "mongo": "docker run --rm -p 27017:27017 --name test-mongo -v ./data:/data/db \"$(cat MONGO_IMAGE)\"",
    "test": "jest",
    "test:adversarial": "cerbos run --log-level=error --set=storage.disk.directory=../conformance/policies --set=telemetry.disabled=true -- jest --config jest.adversarial.config.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cerbos/core": "^0.33.0",
    "@cerbos/grpc": "^0.29.0",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "mongoose": "^9.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.4.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@cerbos/core": "^0.32.0 || ^0.33.0"
  }
}
